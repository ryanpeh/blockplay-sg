{
  "name": "blockplay-sg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "server": "node --experimental-strip-types --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:sites": "tsc -b && vite build --mode sites",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/smoke-regions.mjs",
    "test:adventure": "node scripts/smoke-adventure.mjs",
    "references:inventory": "node scripts/reference-inventory.mjs",
    "references:static": "node scripts/capture-static-references.mjs",
    "marina:capture": "node scripts/capture-marina.mjs",
    "marina:references": "node scripts/capture-marina-references.mjs",
    "marina:browser-capture": "node scripts/capture-marina-browser.mjs",
    "marina:reconstruct": "node scripts/reconstruct-marina.mjs",
    "marina:usage": "node scripts/api-usage.mjs",
    "test:fps": "node scripts/fps-smoke.mjs",
    "test:armory": "node scripts/armory-smoke.mjs",
    "test:vehicles": "node scripts/vehicle-smoke.mjs",
    "test:fullscreen": "node scripts/fullscreen-smoke.mjs",
    "lan": "pnpm build && node scripts/lan-server.mjs",
    "test:lan": "node --test scripts/lan-server-check.mjs && node scripts/lan-transport-smoke.mjs",
    "test:pointer": "node scripts/pointer-smoke.mjs",
    "test:arena:lan": "node scripts/arena-lan-smoke.mjs",
    "test:arena:solo": "node scripts/arena-solo-smoke.mjs",
    "test:expedition": "node scripts/expedition-ui-smoke.mjs",
    "test:expedition:travel": "node scripts/expedition-travel-smoke.mjs",
    "test:fps:optics": "node scripts/fps-optics-smoke.mjs",
    "test:fps:handling": "node scripts/fps-handling-smoke.mjs",
    "test:fps:survival": "node scripts/fps-survival-smoke.mjs",
    "test:fps:aim-toggle": "node scripts/fps-aim-toggle-smoke.mjs",
    "test:fps:radio": "node scripts/fps-radio-smoke.mjs",
    "test:fps:pilot": "node scripts/fps-pilot-smoke.mjs",
    "test:fps:pilot:travel": "node scripts/fps-pilot-expedition-smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "~3.7.2",
    "@types/google.maps": "^3.58.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11 <12"
  }
}

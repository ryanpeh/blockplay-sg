# Optional: enable Maps JavaScript API and billing in Google Cloud.
# This browser key is public. Restrict it by HTTP referrer and API.
VITE_GOOGLE_MAPS_API_KEY=

# Optional separate browser/demo key: Maps JavaScript API only is sufficient.
# When set, Vite prefers this key for the live viewer and browser captures.
# Explicitly exposed to the browser; restrict by HTTP referrer. Not a secret key.
# Static capture scripts still use VITE_GOOGLE_MAPS_API_KEY above.
GOOGLE_MAPS_DEMO_API_KEY=

# Private server-only event key. Never prefix OpenAI credentials with VITE_.
OPENAI_API_KEY=
# Only change for an event-provided OpenAI-compatible endpoint supporting both APIs.
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional comma-separated browser origins; defaults include localhost:5173 and :3001.
# ADVENTURE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
